{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "paths": {
      "@paceholder/nodeeditor-js": ["./src/core/index.ts"],
      "@paceholder/nodeeditor-js/view": ["./src/view/index.ts"],
      "@paceholder/nodeeditor-js/view/advanced": ["./src/view/advanced.ts"],
      "@paceholder/nodeeditor-js/react": ["./src/react/index.ts"]
    }
  },
  "include": ["examples"],
  // Vite configs run in Node; @types/node is not a dependency.
  "exclude": ["examples/**/vite.config.ts"]
}
