{
  "name": "@paceholder/nodeeditor-js",
  "version": "0.2.0",
  "description": "General-purpose node editor library for JavaScript/TypeScript with React integration",
  "keywords": [
    "node-editor",
    "graph",
    "canvas",
    "react",
    "typescript",
    "diagram",
    "flow"
  ],
  "homepage": "https://github.com/paceholder/nodeeditor-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paceholder/nodeeditor-js.git"
  },
  "bugs": {
    "url": "https://github.com/paceholder/nodeeditor-js/issues"
  },
  "author": {
    "name": "Dmitry Pinaev",
    "url": "https://github.com/paceholder"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./view": {
      "types": "./dist/view/index.d.ts",
      "import": "./dist/view/index.js"
    },
    "./view/advanced": {
      "types": "./dist/view/advanced.d.ts",
      "import": "./dist/view/advanced.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.examples.json --noEmit && tsc -p tsconfig.bench.json --noEmit",
    "test": "vitest run --project node",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:browser": "vitest run --project browser",
    "demo": "vite --config examples/plain-js/vite.config.ts",
    "demo:build": "vite build --config examples/plain-js/vite.config.ts",
    "demo:preview": "vite preview --config examples/plain-js/vite.config.ts",
    "test:bench": "vitest run --config bench/vitest.bench.config.ts --project unit",
    "bench": "npm run build && vitest bench --config bench/vitest.bench.config.ts --project \"node (bench)\" --reporter=verbose",
    "bench:browser": "npm run build && node scripts/keep-awake.mjs vitest run --config bench/vitest.bench.config.ts --project \"browser*\"",
    "bench:size": "node scripts/bundle-size.mjs",
    "bench:baseline": "node scripts/baseline.mjs",
    "demo:react": "vite --config examples/react/vite.config.ts",
    "demo:react:build": "vite build --config examples/react/vite.config.ts",
    "demo:perf": "vite --config examples/perf/vite.config.ts",
    "demo:perf:build": "vite build --config examples/perf/vite.config.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "@types/react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
